# ---- Site ----
SITE_NAME=PinPicX
SITE_URL=https://yoursite.com
ABUSE_EMAIL=abuse@yoursite.com
# Hostname Caddy serves (Docker Compose only; no scheme).
SITE_HOST=yoursite.com

# ---- Database ----
POSTGRES_PASSWORD=change-me-long-random

# ---- Storage: Cloudflare R2 (see R2.md) ----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=pinpicx
# Custom domain connected to the bucket. Image links point here and are served by
# Cloudflare's CDN straight from R2. Leave empty to serve images through this site instead.
R2_PUBLIC_URL=https://img.yoursite.com
# Only for buckets created in a data-location jurisdiction: eu or fedramp.
R2_JURISDICTION=

# Optional, recommended with R2_PUBLIC_URL: purge Cloudflare's cache when an image is
# deleted, so it disappears at once. Token permission: Zone → Cache Purge → Purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ---- Local development without R2 (MinIO) ----
# Leave R2_ACCOUNT_ID empty and start MinIO with: docker compose --profile local-storage up -d
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_BUCKET=pinpicx
# S3_ACCESS_KEY_ID=minio-admin
# S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# ---- Uploads and delivery ----
# direct: browsers upload straight to R2 with signed URLs (needs the bucket CORS rule)
# server: browsers send files to this app, which stores them
UPLOAD_MODE=direct
# Leave empty for the automatic choice: "public" when R2_PUBLIC_URL is set, otherwise
# "redirect" (links on this site redirect to signed R2 URLs). "proxy" streams through the app.
IMAGE_DELIVERY=
# Read the client IP from this header only (e.g. x-real-ip on Railway). Leave empty behind Caddy.
CLIENT_IP_HEADER=

# ---- Limits ----
MAX_UPLOAD_MB=32
MAX_PIXELS=100000000
GUEST_UPLOADS_PER_HOUR=30
REPORTS_PER_HOUR=10
# Set to true only if ALL traffic to the site reaches the server through Cloudflare's proxy.
TRUST_CLOUDFLARE=false

# ---- Accounts ----
# Accounts with these emails become admins (moderation at /admin) when they sign up or sign in.
ADMIN_EMAILS=you@yoursite.com
ALLOW_SIGNUP=true
# true: only signed-in users can upload from the website (the API always needs a key)
REQUIRE_LOGIN_TO_UPLOAD=true
# Plan prices per month, in PRICE_CURRENCY: the currency you actually charge in.
# Yearly = (12 − YEARLY_FREE_MONTHS) × monthly. With Paddle on, the yearly price set in Paddle is used instead.
YEARLY_FREE_MONTHS=1
# Visitors can view prices in other currencies on /pricing (USD by default), converted at the latest daily rate.
# With Paddle on, the pricing page reads the real prices from Paddle and these are only a fallback.
PRICE_CURRENCY=LKR
PRO_PRICE=990
BUSINESS_PRICE=4900
CONTACT_EMAIL=hello@yoursite.com
# Refund window shown on /refunds, in days after a payment
REFUND_DAYS=14
# API limits per plan (keys per account, API uploads per hour across all keys)
FREE_API_KEYS=1
FREE_API_UPLOADS_PER_HOUR=10
# Storage per account in GB (originals plus thumbnails). Over the limit, uploads are refused; nothing is deleted.
FREE_STORAGE_GB=1
PRO_STORAGE_GB=50
BUSINESS_STORAGE_GB=500
# Website uploads per hour per account (counted separately from API uploads)
FREE_WEB_UPLOADS_PER_HOUR=50
PRO_WEB_UPLOADS_PER_HOUR=200
BUSINESS_WEB_UPLOADS_PER_HOUR=200
PRO_API_KEYS=5
PRO_API_UPLOADS_PER_HOUR=500
BUSINESS_API_KEYS=20
BUSINESS_API_UPLOADS_PER_HOUR=5000
SESSION_DAYS=30

# ---- Social sign-in (see SOCIAL_LOGIN.md) ----
# Each provider appears on the sign-in page once both of its values are set.
# Callback URLs: SITE_URL/auth/github/callback, /auth/google/callback, /auth/facebook/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Moderation ----
# Optional NSFW scoring endpoint: receives image bytes, returns {"nsfw": 0..1}
MODERATION_WEBHOOK_URL=
MODERATION_THRESHOLD=0.8

# ---- Worker ----
WORKER_CONCURRENCY=2
# true: the web app also processes images, so no separate worker service is needed.
RUN_WORKER=false

# ---- Payments (Paddle Billing; see PADDLE.md) ----
# Leave empty to keep "email us to upgrade". sandbox = test mode, production = real payments.
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=
