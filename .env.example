# ---- Site ----
SITE_NAME=imghost
SITE_URL=https://yoursite.com
# Direct image links. Leave as https://i.yoursite.com when using the Caddy image host,
# or remove to serve images from SITE_URL/i.
IMAGE_BASE_URL=https://i.yoursite.com
ABUSE_EMAIL=abuse@yoursite.com

# Hostnames Caddy serves (no scheme).
SITE_HOST=yoursite.com
IMAGE_HOST=i.yoursite.com
S3_HOST=s3.yoursite.com

# ---- Database ----
POSTGRES_PASSWORD=change-me-long-random

# ---- Storage (S3-compatible) ----
# MinIO in Docker (default):
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://s3.yoursite.com
S3_REGION=us-east-1
S3_BUCKET=imghost
S3_ACCESS_KEY_ID=imghost-admin
S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
S3_FORCE_PATH_STYLE=true
#
# Cloudflare R2 instead (remove minio services from docker-compose.yml):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
# Also add a CORS rule on the R2 bucket allowing PUT from SITE_URL with Content-Type.

# ---- Delivery ----
# direct: browsers PUT to storage with presigned URLs (needs bucket CORS)
# server: browsers POST to this app, which stores the file
UPLOAD_MODE=direct
# proxy: /i/... streams bytes through the app (best with a CDN in front)
# redirect: /i/... redirects to a signed storage URL (use when storage egress is free, e.g. Railway)
IMAGE_DELIVERY=proxy
# Read the client IP from this header only (e.g. x-real-ip on Railway). Leave empty behind Caddy.
CLIENT_IP_HEADER=

# ---- Limits ----
MAX_UPLOAD_MB=32
MAX_PIXELS=100000000
GUEST_UPLOADS_PER_HOUR=30
# Set to true only if ALL traffic reaches Caddy through Cloudflare's proxy.
TRUST_CLOUDFLARE=false
REPORTS_PER_HOUR=10

# ---- Accounts ----
# Accounts with these emails become admins (moderation at /admin) when they sign up or sign in.
ADMIN_EMAILS=you@yoursite.com
ALLOW_SIGNUP=true
# true: only signed-in users can upload from the website (the API always needs a key)
REQUIRE_LOGIN_TO_UPLOAD=true
USER_UPLOADS_PER_HOUR=200
MAX_API_KEYS_PER_USER=10
SESSION_DAYS=30

# ---- Moderation ----
# Optional NSFW scoring endpoint: receives image bytes, returns {"nsfw": 0..1}
MODERATION_WEBHOOK_URL=
MODERATION_THRESHOLD=0.8

# ---- Worker ----
WORKER_CONCURRENCY=2
